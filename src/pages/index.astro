---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const books = await getCollection("books");

---

<Layout title="Libros para programadores">
  <main>
    <h1 class="text-center text-7xl font-extrabold">
      Dev 📓<span class="block">Books</span>
    </h1>
  </main>
  <section aria-label="Libros recomendados para programadores">
    <div class="grid gap-5 md:grid-cols-2">
      {books.map((book: any) => {
        const {slug, data} = book;
        const {title, author, img, readtime, description, buy} = data;

        return (
          <article>
            <img src={`/img/${img}`} alt={title} class="w-full object-cover rounded-lg" /> 
            <h3>{title}</h3>
          </article>
        );
      })}
    </div>
  </section>
</Layout>
